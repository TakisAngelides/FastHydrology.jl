/Manifest*.toml
.DS_Store
docs/src/examples/input/

# Only the maintained test suite is tracked under test/ (runtests.jl, the test-only Project.toml,
# and everything under common/ and models/, mirroring src/'s layout). Everything else --
# exploratory/one-off scripts, real datasets, generated figures -- is ignored wholesale so new
# scratch folders never need a new .gitignore line.
/test/*
!/test/Project.toml
!/test/runtests.jl
!/test/common
!/test/models

# The code guide (LaTeX sources) and the code tour (script, notebook, notebook generator) are
# maintained documentation, so they are tracked; their build products, logs, outputs and
# environments stay ignored.
!/test/code_guide
/test/code_guide/build/
!/test/code_tour
/test/code_tour/Manifest*.toml
/test/code_tour/logs/
/test/code_tour/output/
/test/code_tour/previous/
/test/code_tour/notebook_check.log
/test/code_tour/notebook_extracted_check.jl
